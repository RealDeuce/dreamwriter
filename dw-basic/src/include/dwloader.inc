; Fixed ROM CARD loader ABI visible to DW-BASIC.

%ifndef DW_BASIC_DWLOADER_INC
%define DW_BASIC_DWLOADER_INC

DW_LOADER_SEGMENT equ 0x0A4F

DW_LOADER_ABI_OFFSET equ 0x0010
DW_LOADER_ABI_MAGIC equ DW_LOADER_ABI_OFFSET + 0
DW_LOADER_ABI_VERSION equ DW_LOADER_ABI_OFFSET + 2
DW_LOADER_ABI_LIMIT equ DW_LOADER_ABI_OFFSET + 4
DW_LOADER_ABI_BASIC_SEGMENT equ DW_LOADER_ABI_OFFSET + 6
DW_LOADER_ABI_BASIC_STACK_TOP equ DW_LOADER_ABI_OFFSET + 8
DW_LOADER_ABI_EXIT_THUNK_OFF equ DW_LOADER_ABI_OFFSET + 10
DW_LOADER_ABI_EXIT_THUNK_SEG equ DW_LOADER_ABI_OFFSET + 12
DW_LOADER_ABI_SIZE equ 14

DW_LOADER_ABI_MAGIC_VALUE equ 0x5744 ; "DW"
DW_LOADER_ABI_VERSION_VALUE equ 1

DW_LOADER_EXIT_THUNK_OFFSET equ 0x0030

%endif
